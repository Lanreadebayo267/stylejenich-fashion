# Leave blank to use the local Vite proxy to http://127.0.0.1:8000.
# In Vercel Preview/Production, set this to your deployed FastAPI origin.
VITE_API_BASE_URL=

# Backend-only variables (never use the VITE_ prefix for secrets).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://stylejenich-fashion.vercel.app
STYLEJENICH_SEMANTIC_SEARCH=0
